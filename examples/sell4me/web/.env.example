PAWABASE_ENVIRONMENT=development
SELL4ME_WEB_SECRET=change-me-to-a-long-random-string
SELL4ME_WEB_ORIGIN=http://localhost:3000
STOREFRONT_SUFFIX=shop.localhost:3000
