# Copy to .env (git-ignored) and fill in. `pawabase deploy` and `pawabase emulate` read these.
PAWABASE_URL=http://127.0.0.1:18080
PAWABASE_API_KEY=pb_sk_...        # a SECRET key of the development environment (scripts/provision.py prints one)
# Optional: PAWABASE_ENVIRONMENT=development  PAWABASE_BRANCH=my-feature
