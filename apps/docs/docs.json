{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Pawabase",
  "description": "Build, secure, automate, and operate application backends with Pawabase.",
  "colors": {
    "primary": "#6D5BD0",
    "light": "#B9ABFF",
    "dark": "#5A48BD"
  },
  "background": {
    "color": {
      "light": "#FBFAFE",
      "dark": "#121118"
    },
    "decoration": "gradient"
  },
  "fonts": {
    "family": "Plus Jakarta Sans",
    "weight": 500,
    "heading": {
      "family": "Plus Jakarta Sans",
      "weight": 800
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "search": {
    "prompt": "Search resources, policies, flows…"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "navbar": {
    "links": [
      { "label": "GitHub", "href": "https://github.com/sillohq/pawabase" },
      { "label": "Sillo", "href": "https://sillo.build" }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
